{
  "name": "@local/dsh-openui-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive OpenUI answers in the native DeepSeek Harness conversation.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "render.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@openuidev/lang-core": "^1.0.2",
    "@openuidev/react-headless": "^0.18.1",
    "@openuidev/react-lang": "^1.0.2",
    "@openuidev/react-ui": "^0.18.1",
    "esbuild": "^0.25.10",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate": "node scripts/gen.mjs",
    "test": "node --test test/*.test.mjs",
    "test:render": "node scripts/render-test.mjs"
  }
}
