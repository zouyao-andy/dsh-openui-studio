{
  "name": "dsh-openui-studio",
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive OpenUI answers in the native DeepSeek Harness conversation.",
  "keywords": ["dsh-plugin", "deepseek-harness", "openui", "interactive-ui"],
  "homepage": "https://github.com/zouyao-andy/dsh-openui-studio#readme",
  "bugs": { "url": "https://github.com/zouyao-andy/dsh-openui-studio/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/zouyao-andy/dsh-openui-studio.git" },
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "render.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "devDependencies": {
    "@openuidev/lang-core": "^1.0.2",
    "@openuidev/react-headless": "^0.18.1",
    "@openuidev/react-lang": "^1.0.2",
    "@openuidev/react-ui": "^0.18.1",
    "esbuild": "^0.25.10",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate": "node scripts/gen.mjs",
    "test": "node --test test/*.test.mjs",
    "test:render": "node scripts/render-test.mjs",
    "prepublishOnly": "npm run build && npm test && npm run test:render"
  }
}
